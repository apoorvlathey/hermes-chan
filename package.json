{
  "name": "hermes-chan-ui",
  "productName": "HermesChan",
  "version": "0.3.1",
  "private": true,
  "description": "A small, friendly desktop chat for Hermes Agent bots",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe": "tsx scripts/probe.ts",
    "sync-shared": "bash scripts/sync-shared.sh",
    "package": "electron-vite build && electron-builder --mac --dir",
    "release:build": "electron-vite build && electron-builder --mac --arm64 -c.mac.identity=- --publish never",
    "install-app": "bash scripts/install-app.sh",
    "demo": "electron-vite build && HERMESCHAN_DEMO=1 electron ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller",
      "dmg-license"
    ]
  },
  "build": {
    "appId": "app.hermeschan.desktop",
    "productName": "HermesChan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "lowlight": "3.3.0"
  }
}
